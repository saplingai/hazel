{
  "name": "hazel-server",
  "version": "5.1.1",
  "main": "lib/index.js",
  "description": "Lightweight update server for Electron apps",
  "scripts": {
    "dev": "npx vercel dev",
    "test": "xo && jest",
    "precommit": "lint-staged"
  },
  "engines": {
    "node": "24.x"
  },
  "license": "MIT",
  "repository": "vercel/hazel",
  "xo": {
    "extends": [
      "prettier"
    ],
    "rules": {
      "camelcase": 0,
      "new-cap": 0,
      "unicorn/no-process-exit": 0,
      "no-await-in-loop": 0,
      "unicorn/import-index": 0,
      "ava/assertion-arguments": 0,
      "ava/no-async-fn-without-await": 0,
      "ava/no-duplicate-modifiers": 0,
      "ava/no-identical-title": 0,
      "ava/no-ignored-test-files": 0,
      "ava/no-invalid-end": 0,
      "ava/no-nested-tests": 0,
      "ava/no-only-test": 0,
      "ava/no-skip-assert": 0,
      "ava/no-skip-test": 0,
      "ava/no-statement-after-end": 0,
      "ava/no-todo-implementation": 0,
      "ava/no-todo-test": 0,
      "ava/no-unknown-modifiers": 0,
      "ava/prefer-async-await": 0,
      "ava/test-ended": 0,
      "ava/test-title": 0,
      "ava/use-t-well": 0,
      "ava/use-t": 0,
      "ava/use-test": 0,
      "ava/use-true-false": 0,
      "promise/prefer-await-to-then": 0
    }
  },
  "lint-staged": {
    "*.js": [
      "yarn test && :",
      "prettier --single-quote --no-semi --write --no-editorconfig",
      "git add"
    ]
  },
  "dependencies": {
    "async-retry": "1.2.3",
    "date-fns": "1.29.0",
    "express-useragent": "1.0.12",
    "fetch": "1.1.0",
    "finalhandler": "1.1.0",
    "handlebars": "4.0.11",
    "jest": "24.0.0",
    "micro": "9.3.3",
    "ms": "2.1.1",
    "node-fetch": "2.0.0",
    "router": "1.3.2",
    "semver": "5.5.0",
    "stream-to-string": "1.1.0",
    "test-listen": "1.1.0"
  },
  "devDependencies": {
    "eslint-config-prettier": "2.9.0",
    "husky": "0.14.3",
    "lint-staged": "7.0.0",
    "prettier": "1.10.2",
    "xo": "0.20.3"
  }
}
